# Copy to `.env` in the repo root (never commit `.env`):
#   cp .env.example .env
#
# Backend loads this file automatically on startup (via dotenv-java).
# Docker Compose also reads it via `env_file: .env`.
# For the Vite frontend, also copy VITE_* into Frontend/.env (or run `make env`).

# --- Required for the agent trader ---
GROQ_API_KEY=
# Finnhub removed in agent-trader-v3 (web research + Yahoo quotes).

# --- Optional Groq / agent knobs ---
GROQ_MODEL_FAST=llama-3.1-8b-instant
GROQ_MODEL_JUDGE=llama-3.3-70b-versatile
AGENT_ALLOWANCE=1000
AGENT_CASH_RESERVE_PCT=0.15
AGENT_TIMEOUT_MS=60000

# --- PostgreSQL (matches docker-compose defaults) ---
POSTGRES_DB=postfolio
POSTGRES_USER=postfolio
POSTGRES_PASSWORD=postfolio
POSTGRES_PORT=5432

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/postfolio
SPRING_DATASOURCE_USERNAME=postfolio
SPRING_DATASOURCE_PASSWORD=postfolio

# --- Frontend (Vite) — must be prefixed with VITE_ ---
VITE_SERVER_URL=http://localhost:8080
VITE_CLIENT_URL=http://localhost:5173

# --- App ports (docker-compose) ---
BACKEND_PORT=8080
FRONTEND_PORT=5173
